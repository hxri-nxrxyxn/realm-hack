{
  "name": "realm-hack",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo workspace for realm-hack: client, gateway, and server",
  "scripts": {
    "dev:client": "npm --prefix client run dev",
    "dev:gateway": "npm --prefix gateway run dev",
    "dev:server": "npm --prefix server/backend run dev",
    "build:client": "npm --prefix client run build",
    "build:gateway": "npm --prefix gateway run build",
    "build:server": "npm --prefix server/backend run build",
    "build": "npm run build:client && npm run build:server"
  }
}
